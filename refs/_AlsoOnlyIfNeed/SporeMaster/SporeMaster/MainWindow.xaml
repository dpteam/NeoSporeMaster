<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="SporeMaster.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SporeMaster" Title="SporeMaster" Height="600" Width="1024">
  <FrameworkElement.Resources>
    <ResourceDictionary />
  </FrameworkElement.Resources>
  <Grid>
    <TabControl Name="tabControl" SelectionChanged="tabControl_SelectionChanged">
      <TabItem Name="packages" Header="Spore Packages">
        <Grid HorizontalAlignment="Stretch">
          <TextBlock Height="54" Margin="6,6,6,0" VerticalAlignment="Top" TextWrapping="Wrap">Before you can mod Spore, you need to unpack some of Spore's .package files so that you have something to study and work with. The below list is the recommended set of files to unpack, but SporeMaster doesn't know where to find them in Spore's Data folder. Select each file, click Change, and locate it; then click Unpack. Advanced users can change and reorder the set of packages.</TextBlock>
          <Grid Margin="0,66,0,0">
            <ListView Name="PackageList" Margin="6,35.04,6,61" SelectionMode="Single" SelectionChanged="PackageList_SelectionChanged">
              <ListViewItem>Spore_Game.package</ListViewItem>
              <ListViewItem>Text.package</ListViewItem>
            </ListView>
            <Button Name="Btn_NewPackage" Height="23" Margin="6,6,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Width="100" Click="Btn_NewPackage_Click">New</Button>
            <Button Name="Btn_EditPackage" Height="23" Margin="112,6,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Width="100" IsEnabled="False" Click="Btn_EditPackage_Click">Change</Button>
            <Button Name="Btn_RemovePackage" Height="23" Margin="218,6,136,0" VerticalAlignment="Top" HorizontalAlignment="Left" Width="100" IsEnabled="False" Click="Btn_RemovePackage_Click">Remove</Button>
            <Button Name="Btn_Unpack" Height="23" Margin="157,0,161,6" VerticalAlignment="Bottom" Click="Btn_Unpack_Click">Unpack</Button>
            <Button Name="Btn_PackageUp" Height="23" HorizontalAlignment="Right" Margin="0,6,62,0" VerticalAlignment="Top" Width="50" IsEnabled="False" Click="Btn_PackageUp_Click">Up</Button>
            <Button Name="Btn_PackageDown" Height="23" HorizontalAlignment="Right" Margin="0,6,6,0" VerticalAlignment="Top" Width="50" IsEnabled="False" Click="Btn_PackageDown_Click">Down</Button>
          </Grid>
        </Grid>
      </TabItem>
      <TabItem Name="EditMod" Header="Mod">
        <Grid>
          <GroupBox Name="groupBox1" Header="Select Mod to Edit" Margin="6,6,6,0" Height="58" VerticalAlignment="Top">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="177*" />
                <ColumnDefinition Width="253*" />
              </Grid.ColumnDefinitions>
              <TextBox Name="ModPath" Height="23" Margin="6,6,141,0" VerticalAlignment="Top" Grid.ColumnSpan="2" />
              <Button Name="NewMod" Margin="0,6,70,0" HorizontalAlignment="Right" Width="65" Height="23" VerticalAlignment="Top" Grid.Column="1" Click="NewMod_Click">Create</Button>
              <Button Name="OpenMod" HorizontalAlignment="Right" Margin="0,6,6,0" Width="58" Height="23" VerticalAlignment="Top" Grid.Column="1" Click="OpenMod_Click">Open</Button>
            </Grid>
          </GroupBox>
          <GroupBox Margin="5,70,6,6" Header="Mod Operations">
            <Grid>
              <Button Name="Unpack_Mod" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="7,6,0,0" Height="23" Width="75" IsEnabled="False" Click="Unpack_Mod_Click">Unpack</Button>
              <Button Name="Pack_Mod" Height="23" HorizontalAlignment="Left" Margin="7,35,0,0" VerticalAlignment="Top" Width="75" IsEnabled="False" Click="Pack_Mod_Click">Pack</Button>
              <TextBlock Name="Unpack_Mod_Doc" Height="21" Margin="88,6,6,0" VerticalAlignment="Top" />
              <TextBlock Name="Pack_Mod_Doc" Height="21" Margin="88,37,6,0" VerticalAlignment="Top" />
            </Grid>
          </GroupBox>
        </Grid>
      </TabItem>
      <TabItem Name="TabFilesEditor" Header="Files" IsEnabled="False">
        <local:FilesEditor x:Name="FilesEditor" />
      </TabItem>
      <TabItem Name="NamesTab" Header="Names">
        <local:NameEditor x:Name="NameEditor" HorizontalAlignment="Stretch" />
      </TabItem>
      <TabItem Name="AboutTab" Header="About">
        <FlowDocumentPageViewer Margin="6,6,6,6" Document="{StaticResource AboutSporeMaster}" />
      </TabItem>
    </TabControl>
  </Grid>
</Window>