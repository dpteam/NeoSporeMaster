<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>SporeMaster.Gui</RootNamespace>
    <AssemblyName>SporeMaster</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>SporeMaster3.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SporeMaster.Core\SporeMaster.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="app.manifest" />
    <Resource Include="SporeMaster3.ico" />
  </ItemGroup>

</Project>
