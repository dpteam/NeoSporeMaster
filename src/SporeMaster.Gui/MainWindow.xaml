<Window x:Class="SporeMaster.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SporeMaster.Gui"
        Title="SporeMaster 3" Height="760" Width="1240"
        Icon="SporeMaster3.ico"
        AllowDrop="True" Drop="OnFileDrop" DragOver="OnDragOver"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="{loc:Loc gui.menu.file}">
                <MenuItem Header="{loc:Loc gui.menu.open}" Click="OnOpenPackage" InputGestureText="Ctrl+O" />
                <MenuItem Header="{loc:Loc gui.menu.back}" Click="OnOpenPreviousPackage" />
                <MenuItem Header="{loc:Loc gui.menu.close}" Click="OnClosePackage" />
                <Separator />
                <MenuItem Header="{loc:Loc gui.menu.exit}" Click="OnExit" />
            </MenuItem>
            <MenuItem Header="{loc:Loc gui.menu.edit}">
                <MenuItem Header="{loc:Loc gui.menu.copyKey}" Click="OnCopyKey" />
                <MenuItem Header="{loc:Loc gui.menu.copyName}" Click="OnCopyName" />
                <Separator />
                <MenuItem Header="{loc:Loc gui.menu.selectAll}" Click="OnSelectAll" InputGestureText="Ctrl+A" />
                <MenuItem Header="{loc:Loc gui.menu.invert}" Click="OnInvertSelection" />
            </MenuItem>
            <MenuItem Header="{loc:Loc gui.menu.view}">
                <MenuItem Header="{loc:Loc gui.menu.refresh}" Click="OnRefresh" />
                <Separator />
                <MenuItem x:Name="DetailsMenuItem" Header="{loc:Loc gui.menu.details}" Click="OnViewDetails" IsCheckable="True" IsChecked="True" />
                <MenuItem x:Name="LargeIconsMenuItem" Header="{loc:Loc gui.menu.largeIcons}" Click="OnViewLargeIcons" IsCheckable="True" />
                <MenuItem x:Name="DetailsPaneMenuItem" Header="{loc:Loc gui.menu.detailsPane}" Click="OnToggleDetailsPane" IsCheckable="True" IsChecked="True" />
                <MenuItem x:Name="ShowSkeletonMenuItem" Header="{loc:Loc gui.menu.showSkeleton}" Click="OnToggleSkeleton" IsCheckable="True" />
                <MenuItem x:Name="PropertiesPaneMenuItem" Header="{loc:Loc gui.menu.propertiesPane}" Click="OnTogglePropertiesPane" IsCheckable="True" />
                <Separator />
                <MenuItem Header="{loc:Loc gui.menu.language}">
                    <MenuItem x:Name="LanguageEnMenuItem" Header="English" IsCheckable="True" IsChecked="True" Click="OnLanguageEn" />
                    <MenuItem x:Name="LanguageRuMenuItem" Header="Русский" IsCheckable="True" Click="OnLanguageRu" />
                </MenuItem>
            </MenuItem>
            <MenuItem Header="{loc:Loc gui.menu.tools}">
                <MenuItem Header="{loc:Loc gui.menu.extractSelected}" Click="OnExtractSelected" />
                <MenuItem Header="{loc:Loc gui.menu.extractAll}" Click="OnExtractAll" />
                <MenuItem Header="{loc:Loc gui.menu.extractFolder}" Click="OnExtractFolder" />
                <MenuItem Header="{loc:Loc gui.menu.extractChecked}" Click="OnExtractChecked" />
                <Separator />
                <MenuItem Header="{loc:Loc gui.menu.exportModels}">
                    <MenuItem Header="{loc:Loc gui.menu.exportModelsObj}" Click="OnExportAllModelsObj" />
                    <MenuItem Header="{loc:Loc gui.menu.exportModelsOgre}" Click="OnExportAllModelsOgre" />
                </MenuItem>
                <Separator />
                <MenuItem Header="{loc:Loc gui.menu.checkAll}" Click="OnCheckAllFolders" />
                <MenuItem Header="{loc:Loc gui.menu.uncheckAll}" Click="OnUncheckAllFolders" />
                <Separator />
                <MenuItem Header="{loc:Loc gui.menu.loadNames}" Click="OnLoadNames" />
                <MenuItem Header="{loc:Loc gui.menu.loadKeyMap}" Click="OnLoadKeyMap" />
                <Separator />
                <MenuItem Header="{loc:Loc gui.menu.compare}" Click="OnComparePackages" />
                <Separator />
                <MenuItem Header="{loc:Loc gui.menu.flatView}" Click="OnFlatViewToggle" IsCheckable="True" />
            </MenuItem>
            <MenuItem Header="{loc:Loc gui.menu.help}">
                <MenuItem Header="{loc:Loc gui.menu.about}" Click="OnAbout" />
            </MenuItem>
        </Menu>

        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button Content="{loc:Loc gui.toolbar.back}" Click="OnBack" />
                <Button Content="{loc:Loc gui.toolbar.forward}" Click="OnForward" />
                <Button Content="{loc:Loc gui.toolbar.up}" Click="OnUp" />
                <Separator />
                <Button Content="{loc:Loc gui.toolbar.open}" Click="OnOpenPackage" />
                <Button Content="{loc:Loc gui.toolbar.extract}" Click="OnExtractSelected" />
                <Button Content="{loc:Loc gui.toolbar.extractChecked}" Click="OnExtractChecked" />
            </ToolBar>
        </ToolBarTray>

        <Border DockPanel.Dock="Top" Background="#F7F7F7" BorderBrush="#DDD" BorderThickness="0,0,0,1">
            <DockPanel Margin="6,3">
                <TextBlock DockPanel.Dock="Left" Text="{loc:Loc gui.address}" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="#666" />
                <ComboBox x:Name="AddressBox" DockPanel.Dock="Left" Width="360" IsEditable="True" IsTextSearchEnabled="False"
                          VerticalAlignment="Center" ToolTip="{loc:Loc gui.addressTip}"
                          KeyDown="OnAddressKeyDown" SelectionChanged="OnAddressSelected" />
                <TextBlock x:Name="Breadcrumb" VerticalAlignment="Center" FontWeight="SemiBold" Margin="10,0,0,0"
                           TextTrimming="CharacterEllipsis" />
                <TextBox x:Name="FilterBox" DockPanel.Dock="Right" Width="280" TextChanged="OnFilterChanged"
                         KeyDown="OnFilterKeyDown" ToolTip="{loc:Loc gui.filterTip}" />
                <TextBlock DockPanel.Dock="Right" Text="{loc:Loc gui.search}" VerticalAlignment="Center" Margin="8,0,4,0" />
            </DockPanel>
        </Border>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="{loc:Loc gui.status.open}" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="CountText" Foreground="#666" />
            </StatusBarItem>
        </StatusBar>

        <Border DockPanel.Dock="Bottom" Background="#F7F7F7" BorderBrush="#DDD" BorderThickness="0,1,0,0"
                Visibility="Collapsed" x:Name="DetailsPane">
            <Grid Margin="8,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc gui.details.name}" Foreground="#666" Margin="0,0,4,2" />
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="DetailsName" TextTrimming="CharacterEllipsis" Margin="0,0,12,2" />
                <TextBlock Grid.Row="0" Grid.Column="2" Text="{loc:Loc gui.details.type}" Foreground="#666" Margin="0,0,4,2" />
                <TextBlock Grid.Row="0" Grid.Column="3" x:Name="DetailsType" TextTrimming="CharacterEllipsis" Margin="0,0,0,2" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc gui.details.key}" Foreground="#666" Margin="0,0,4,0" />
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="DetailsKey" FontFamily="Consolas" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                <TextBlock Grid.Row="1" Grid.Column="2" Text="{loc:Loc gui.details.size}" Foreground="#666" Margin="0,0,4,0" />
                <TextBlock Grid.Row="1" Grid.Column="3" x:Name="DetailsSize" TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TreeColumn" Width="260" MinWidth="160" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="2*" MinWidth="300" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="3*" MinWidth="280" />
            </Grid.ColumnDefinitions>

            <TreeView x:Name="FolderTree" Grid.Column="0"
                      SelectedItemChanged="OnFolderSelected"
                      VirtualizingStackPanel.IsVirtualizing="True"
                      VirtualizingStackPanel.VirtualizationMode="Recycling">
                <TreeView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{loc:Loc gui.folder.open}" Click="OnFolderMenuOpen" />
                        <Separator />
                        <MenuItem Header="{loc:Loc gui.folder.check}" Click="OnFolderMenuCheck" />
                        <MenuItem Header="{loc:Loc gui.folder.uncheck}" Click="OnFolderMenuUncheck" />
                        <Separator />
                        <MenuItem Header="{loc:Loc gui.folder.extract}" Click="OnExtractFolder" />
                        <MenuItem Header="{loc:Loc gui.folder.copyName}" Click="OnFolderMenuCopyName" />
                    </ContextMenu>
                </TreeView.ContextMenu>
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal">
                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                      IsThreeState="{Binding IsThreeState}"
                                      VerticalAlignment="Center" Margin="0,0,4,0"
                                      Click="OnFolderCheckChanged" />
                            <TextBlock Text="📁 " />
                            <TextBlock Text="{Binding Name}" />
                            <TextBlock Text="{Binding CountText}" Foreground="#888" Margin="6,0,0,0" />
                        </StackPanel>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#DDD" />

            <ListView x:Name="ResourceList" Grid.Column="2"
                      SelectionMode="Extended" SelectionChanged="OnSelectionChanged"
                      MouseDoubleClick="OnListDoubleClick"
                      PreviewMouseLeftButtonDown="OnListMouseDown"
                      PreviewMouseMove="OnListMouseMove"
                      VirtualizingStackPanel.IsVirtualizing="True"
                      VirtualizingStackPanel.VirtualizationMode="Recycling">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="" Width="26" DisplayMemberBinding="{Binding Glyph}" />
                        <GridViewColumn Header="{loc:Loc gui.col.name}" Width="240" DisplayMemberBinding="{Binding ShortName}" />
                        <GridViewColumn Header="{loc:Loc gui.col.type}" Width="110" DisplayMemberBinding="{Binding TypeName}" />
                        <GridViewColumn Header="{loc:Loc gui.col.size}" Width="80" DisplayMemberBinding="{Binding PackedSize}" />
                        <GridViewColumn Header="{loc:Loc gui.col.mem}" Width="80" DisplayMemberBinding="{Binding MemSize}" />
                        <GridViewColumn Header="{loc:Loc gui.col.comp}" Width="60" DisplayMemberBinding="{Binding Compression}" />
                    </GridView>
                </ListView.View>
                <ListView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{loc:Loc gui.res.extract}" Click="OnExtractSelected" />
                        <MenuItem Header="{loc:Loc gui.res.openAsPackage}" Click="OnOpenResourceAsPackage" />
                        <MenuItem Header="{loc:Loc gui.res.extractFolder}" Click="OnExtractFolder" />
                        <Separator />
                        <MenuItem Header="{loc:Loc gui.res.copyKey}" Click="OnCopyKey" />
                        <MenuItem Header="{loc:Loc gui.res.copyName}" Click="OnCopyName" />
                        <Separator />
                        <MenuItem Header="{loc:Loc gui.res.openInPreview}" Click="OnPreviewSelected" />
                    </ContextMenu>
                </ListView.ContextMenu>
            </ListView>

            <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch" Background="#DDD" />

            <DockPanel Grid.Column="4">
                <TextBlock x:Name="PreviewHeader" DockPanel.Dock="Top" Padding="6,4"
                           FontWeight="SemiBold" Text="{loc:Loc gui.preview}" Background="#F3F3F3" TextTrimming="CharacterEllipsis" />
                <Border x:Name="PropertiesPane" DockPanel.Dock="Bottom" Visibility="Collapsed"
                        Background="#F7F7F7" BorderBrush="#DDD" BorderThickness="0,1,0,0" Height="150">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{loc:Loc gui.details.propsTitle}" Padding="6,3"
                                   FontWeight="SemiBold" Background="#F3F3F3" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <TextBlock x:Name="PropertiesText" FontFamily="Consolas" FontSize="12"
                                       Margin="6,4" TextWrapping="Wrap" />
                        </ScrollViewer>
                    </DockPanel>
                </Border>
                <Grid>
                    <TextBox x:Name="PreviewText" IsReadOnly="True" AcceptsReturn="True"
                             FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                    <ScrollViewer x:Name="PreviewImageScroller" Visibility="Collapsed"
                                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#FAFAFA">
                        <Image x:Name="PreviewImage" Stretch="None" Margin="8" />
                    </ScrollViewer>
                    <Grid x:Name="PreviewModelHost" Visibility="Collapsed" Background="#202020"
                          MouseLeftButtonDown="OnModelMouseDown" MouseLeftButtonUp="OnModelMouseUp"
                          MouseMove="OnModelMouseMove" MouseWheel="OnModelMouseWheel">
                        <Viewport3D x:Name="PreviewViewport" ClipToBounds="True" />
                        <TextBlock Text="{loc:Loc gui.model.hint}" Foreground="#BBB"
                                   HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8" />
                        <Slider x:Name="AnimSlider" Minimum="0" Maximum="1" Visibility="Collapsed"
                                VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Margin="8,0,8,4"
                                ValueChanged="OnAnimSliderChanged"
                                ToolTip="{loc:Loc gui.model.animTip}" />
                    </Grid>
                </Grid>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
