<Window x:Class="SporeMaster.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SporeMaster 3" Height="760" Width="1240"
        Icon="SporeMaster3.ico"
        AllowDrop="True" Drop="OnFileDrop" DragOver="OnDragOver"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Open Package..." Click="OnOpenPackage" InputGestureText="Ctrl+O" />
                <MenuItem Header="_Close" Click="OnClosePackage" />
                <Separator />
                <MenuItem Header="E_xit" Click="OnExit" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Copy Resource Key" Click="OnCopyKey" />
                <MenuItem Header="Copy _Name" Click="OnCopyName" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Refresh" Click="OnRefresh" />
                <Separator />
                <MenuItem x:Name="DetailsMenuItem" Header="_Details" Click="OnViewDetails" IsCheckable="True" IsChecked="True" />
                <MenuItem x:Name="LargeIconsMenuItem" Header="Large _Icons" Click="OnViewLargeIcons" IsCheckable="True" />
                <MenuItem x:Name="DetailsPaneMenuItem" Header="Details _pane" Click="OnToggleDetailsPane" IsCheckable="True" IsChecked="True" />
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="_Extract Selected..." Click="OnExtractSelected" />
                <MenuItem Header="Extract _All..." Click="OnExtractAll" />
                <MenuItem Header="Extract _Folder..." Click="OnExtractFolder" />
                <MenuItem Header="Extract Chec_ked Folders..." Click="OnExtractChecked" />
                <Separator />
                <MenuItem Header="Check all folders" Click="OnCheckAllFolders" />
                <MenuItem Header="Uncheck all folders" Click="OnUncheckAllFolders" />
                <Separator />
                <MenuItem Header="Load recovered _names.txt..." Click="OnLoadNames" />
                <MenuItem Header="Back to single list (flat view)" Click="OnFlatViewToggle" IsCheckable="True" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About" Click="OnAbout" />
            </MenuItem>
        </Menu>

        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button Content="← Back" Click="OnBack" />
                <Button Content="→ Forward" Click="OnForward" />
                <Button Content="↑ Up" Click="OnUp" />
                <Separator />
                <Button Content="Open" Click="OnOpenPackage" />
                <Button Content="Extract" Click="OnExtractSelected" />
                <Button Content="Extract Checked" Click="OnExtractChecked" />
            </ToolBar>
        </ToolBarTray>

        <Border DockPanel.Dock="Top" Background="#F7F7F7" BorderBrush="#DDD" BorderThickness="0,0,0,1">
            <DockPanel Margin="6,3">
                <TextBlock DockPanel.Dock="Left" Text="Address:" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="#666" />
                <ComboBox x:Name="AddressBox" DockPanel.Dock="Left" Width="360" IsEditable="True" IsTextSearchEnabled="False"
                          VerticalAlignment="Center" ToolTip="Type a folder name (or 'all') and press Enter"
                          KeyDown="OnAddressKeyDown" SelectionChanged="OnAddressSelected" />
                <TextBlock x:Name="Breadcrumb" VerticalAlignment="Center" FontWeight="SemiBold" Margin="10,0,0,0"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock DockPanel.Dock="Right" Text="Search:" VerticalAlignment="Center" Margin="8,0,4,0" />
                <TextBox x:Name="FilterBox" DockPanel.Dock="Right" Width="280" TextChanged="OnFilterChanged"
                         ToolTip="Filter by name, type or key" />
            </DockPanel>
        </Border>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Open a .package file to begin." />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="CountText" Foreground="#666" />
            </StatusBarItem>
        </StatusBar>

        <Border DockPanel.Dock="Bottom" Background="#F7F7F7" BorderBrush="#DDD" BorderThickness="0,1,0,0"
                Visibility="Collapsed" x:Name="DetailsPane">
            <Grid Margin="8,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Name:" Foreground="#666" Margin="0,0,4,2" />
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="DetailsName" TextTrimming="CharacterEllipsis" Margin="0,0,12,2" />
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Type:" Foreground="#666" Margin="0,0,4,2" />
                <TextBlock Grid.Row="0" Grid.Column="3" x:Name="DetailsType" TextTrimming="CharacterEllipsis" Margin="0,0,0,2" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Key:" Foreground="#666" Margin="0,0,4,0" />
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="DetailsKey" FontFamily="Consolas" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                <TextBlock Grid.Row="1" Grid.Column="2" Text="Size:" Foreground="#666" Margin="0,0,4,0" />
                <TextBlock Grid.Row="1" Grid.Column="3" x:Name="DetailsSize" TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TreeColumn" Width="260" MinWidth="160" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="2*" MinWidth="300" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="3*" MinWidth="280" />
            </Grid.ColumnDefinitions>

            <TreeView x:Name="FolderTree" Grid.Column="0"
                      SelectedItemChanged="OnFolderSelected"
                      VirtualizingStackPanel.IsVirtualizing="True"
                      VirtualizingStackPanel.VirtualizationMode="Recycling">
                <TreeView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Open" Click="OnFolderMenuOpen" />
                        <Separator />
                        <MenuItem Header="Check this folder" Click="OnFolderMenuCheck" />
                        <MenuItem Header="Uncheck this folder" Click="OnFolderMenuUncheck" />
                        <Separator />
                        <MenuItem Header="Extract this folder..." Click="OnExtractFolder" />
                        <MenuItem Header="Copy folder name" Click="OnFolderMenuCopyName" />
                    </ContextMenu>
                </TreeView.ContextMenu>
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal">
                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                      IsThreeState="{Binding IsThreeState}"
                                      VerticalAlignment="Center" Margin="0,0,4,0"
                                      Click="OnFolderCheckChanged" />
                            <TextBlock Text="📁 " />
                            <TextBlock Text="{Binding Name}" />
                            <TextBlock Text="{Binding CountText}" Foreground="#888" Margin="6,0,0,0" />
                        </StackPanel>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#DDD" />

            <ListView x:Name="ResourceList" Grid.Column="2"
                      SelectionMode="Extended" SelectionChanged="OnSelectionChanged"
                      MouseDoubleClick="OnListDoubleClick"
                      PreviewMouseLeftButtonDown="OnListMouseDown"
                      PreviewMouseMove="OnListMouseMove"
                      VirtualizingStackPanel.IsVirtualizing="True"
                      VirtualizingStackPanel.VirtualizationMode="Recycling">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="" Width="26" DisplayMemberBinding="{Binding Glyph}" />
                        <GridViewColumn Header="Name" Width="240" DisplayMemberBinding="{Binding ShortName}" />
                        <GridViewColumn Header="Type" Width="110" DisplayMemberBinding="{Binding TypeName}" />
                        <GridViewColumn Header="Size" Width="80" DisplayMemberBinding="{Binding PackedSize}" />
                        <GridViewColumn Header="Mem" Width="80" DisplayMemberBinding="{Binding MemSize}" />
                        <GridViewColumn Header="Comp" Width="60" DisplayMemberBinding="{Binding Compression}" />
                    </GridView>
                </ListView.View>
                <ListView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Extract..." Click="OnExtractSelected" />
                        <MenuItem Header="Extract Folder..." Click="OnExtractFolder" />
                        <Separator />
                        <MenuItem Header="Copy Resource Key" Click="OnCopyKey" />
                        <MenuItem Header="Copy Name" Click="OnCopyName" />
                        <Separator />
                        <MenuItem Header="Open in preview" Click="OnPreviewSelected" />
                    </ContextMenu>
                </ListView.ContextMenu>
            </ListView>

            <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch" Background="#DDD" />

            <DockPanel Grid.Column="4">
                <TextBlock x:Name="PreviewHeader" DockPanel.Dock="Top" Padding="6,4"
                           FontWeight="SemiBold" Text="Preview" Background="#F3F3F3" TextTrimming="CharacterEllipsis" />
                <Grid>
                    <TextBox x:Name="PreviewText" IsReadOnly="True" AcceptsReturn="True"
                             FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                    <ScrollViewer x:Name="PreviewImageScroller" Visibility="Collapsed"
                                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#FAFAFA">
                        <Image x:Name="PreviewImage" Stretch="None" Margin="8" />
                    </ScrollViewer>
                </Grid>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
