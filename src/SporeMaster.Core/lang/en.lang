# SporeMaster 3 — локализация приложения (EN по умолчанию).
# Формат: ключ = значение. Комментарии начинаются с '#', строки-продолжения отсутствуют.
# ВАЖНО: документация ведётся на русском языке (см. README.md), а интерфейс программы — на английском.
# Полная локализация приложения на русский вынесена в список идей (MEMORY.md).

app.name = SporeMaster 3
app.description = Spore package (DBPF) toolkit

# --- Общие ---
common.ok = OK
common.error = Error
common.warning = Warning
common.done = Done.
common.notFound = Not found: {0}
common.invalidArgument = Invalid argument: {0}
common.fileNotFound = File not found: {0}
common.usage = Usage: {0}

# --- Заголовки вывода ---
header.file = File
header.version = DBPF version
header.type = Type
header.entries = Entries
header.indexOffset = Index offset
header.indexSize = Index size
header.indexType = Index type
header.big = Big package (DBBF)
header.encrypted = Encrypted container (DBPP)

# --- Команды CLI ---
cmd.info.usage = info <package>
cmd.info.summary = Print DBPF header information for a package.
cmd.list.usage = list <package> [--type T] [--group G] [--name S] [--compressed] [--limit N] [--format csv|json] [--out FILE]
cmd.list.summary = List resources inside a package.
cmd.extract.usage = extract <package> <type:group:instance> [--out FILE]
cmd.extract.summary = Extract a single resource by its 3-part key.
cmd.unpack.usage = unpack <package> <output-dir> [--raw] [--clean-autolocales]
cmd.unpack.summary = Unpack every resource (properties -> .prop.xml); --clean-autolocales drops generated locales.
cmd.pack.usage = pack <input-dir> <package> [--version 2.0|3.0] [--compress] [--big]
cmd.pack.summary = Build a package from a folder layout (converts .prop.xml back to .prop).
cmd.prop.usage = prop <input.prop|input.prop.xml> <output>
cmd.prop.summary = Convert a property file to XML or XML back to binary.
cmd.propt.usage = propt <input.prop|input.prop_t> <output>
cmd.propt.summary = Convert a property file to ArgScript text (.prop_t) or back.
cmd.locale.usage = locale <file.locale>
cmd.locale.summary = List the entries of a locale table.
cmd.texture.usage = texture <input.raster|input.dds> <output>
cmd.texture.summary = Convert a rasterized texture to DDS or DDS back to raster.
cmd.bitmap.usage = bitmap <input.bitmap|input.png> <output>
cmd.bitmap.summary = Convert a raw bitmap resource to PNG or PNG back to bitmap.
cmd.guess.usage = guess <hash>... | --package <pkg> [--save names.txt] | --validate <KeyMap.txt> [--limit N]
cmd.guess.summary = Recover names from hashes, or validate the guesser against real key maps.
cmd.search.usage = search <directory> <query> [--ext .prop.xml,.locale] [--limit N]
cmd.search.summary = Case-insensitive text search over unpacked files.
cmd.pctp.usage = pctp <input.pctp|input.pctp_t> <output>
cmd.pctp.summary = Convert a part-capabilities file to text or back.
cmd.tlsa.usage = tlsa <input.tlsa|input.tlsa_t> <output>
cmd.tlsa.summary = Convert a TLSA animation-group file to text or back.
cmd.gait.usage = gait <input.gait|input.gait_t> <output>
cmd.gait.summary = Convert a GAIT locomotion file to text or back.
cmd.cnv.usage = cnv <input.cnv> <output.cnv_t>
cmd.cnv.summary = Dump a conversation file to readable text (import: future work).
cmd.loottable.usage = loottable <input.loottable|input.loottable_t> <output>
cmd.loottable.summary = Convert a cell-stage loot table to text or back.
cmd.looktable.usage = looktable <input.look_table|input.look_table_t> <output>
cmd.looktable.summary = Convert a cell look (steering) table to text or back.
cmd.keymap.usage = keymap <KeyMap.txt> <names.txt> [--types <types.txt>]
cmd.keymap.summary = Extract an authoritative names registry from the game's key map.
cmd.rw4.usage = rw4 <file.rw4> [--export file.obj]
cmd.rw4.summary = Inspect a RenderWare 4 resource and optionally export its meshes to OBJ.
cmd.verify.usage = verify <package>
cmd.verify.summary = Read and decompress every resource, reporting problems.
cmd.hash.usage = hash <name>
cmd.hash.summary = Print the FNV hash of a name.
cmd.types.usage = types
cmd.types.summary = List known resource types (from reg_type.txt).

# --- Результаты ---
result.extracted = Extracted {0} ({1} bytes).
result.unpacked = Unpacked {0} resource(s) to {1}.
result.packed = Packed {0} resource(s) into {1}.
result.verified = Verified {0} resource(s), {1} problem(s).
result.hash = {0} => 0x{1:X8}
