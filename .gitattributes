# Normalise line endings to LF in the repository; check out native on Windows.
* text=auto

*.cs     text diff=csharp
*.csproj text
*.sln    text eol=crlf
*.props  text
*.lang   text
*.md     text
*.txt    text

# Binary assets
*.png   binary
*.jpg   binary
*.gif   binary
*.dll   binary
*.exe   binary
*.pdb   binary
*.ttf   binary
*.package binary
*.dds   binary
