<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <InvariantGlobalization>true</InvariantGlobalization>
    <NeutralLanguage>en-US</NeutralLanguage>
    <Authors>SporeMaster3 contributors</Authors>
    <Product>SporeMaster 3</Product>
    <Version>3.94.0</Version>
    <Copyright>SporeMaster3 contributors</Copyright>
    <!-- No external NuGet packages are used; everything is built on the BCL. -->
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
  </PropertyGroup>

</Project>
